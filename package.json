{
  "name": "mastr-killer",
  "version": "1.0.0",
  "description": "Magic String Killer — turn object property paths into typed, refactor-safe dot-path strings. Kills magic strings for NestJS ConfigService, i18n keys, or any string used to reach an object property.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "clean": "rm -rf dist",
    "test": "jest",
    "prepack": "npm run clean && npm run build",
    "prepublishOnly": "npm test"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/qmarquez/mastr-killer.git"
  },
  "homepage": "https://github.com/qmarquez/mastr-killer#readme",
  "bugs": {
    "url": "https://github.com/qmarquez/mastr-killer/issues"
  },
  "keywords": [
    "magic",
    "string",
    "magicstrings",
    "typescript",
    "proxy",
    "config",
    "nestjs",
    "configservice",
    "i18n",
    "type-safe",
    "paths"
  ],
  "author": "digihood",
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "^9.10.0",
    "@types/jest": "^29.5.13",
    "eslint": "^9.10.0",
    "eslint-config-prettier": "^9.1.0",
    "globals": "^15.9.0",
    "jest": "^29.7.0",
    "prettier": "^3.3.3",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "typescript": "^5.6.2",
    "typescript-eslint": "^8.6.0"
  }
}
